# Configuracion del backend (importador + API). Copia esto a backend/.env:
#     cd backend
#     cp .env.example .env
#
# Vive APARTE del .env.example de la raiz (el del AI Service) a proposito:
# ai-service/tests/unit/test_config.py comprueba que el .env.example de la
# raiz documente EXACTAMENTE las variables que lee gondola/config.py, ni una
# mas. Anadir aqui DATABASE_URL rompia ese test. El backend es una capa
# aparte (ver docs/architecture.md) y tiene su propia configuracion.

# Cadena de conexion a PostgreSQL. El backend es lo unico que la usa: el AI
# Service nunca toca la base de datos.
DATABASE_URL=postgresql://gondola:gondola_dev@localhost:5433/gondola

# Opcional. Carpeta donde el AI Service escribe los videos renderizados
# (RENDER_MODE=privacy, ver ai-service/.env), que sirve GET /videos/{id}/render.
# Por defecto es <raiz del repo>/data/output -el mismo OUTPUT_DIR de
# gondola/config.py-; solo hace falta si corres la API en una maquina
# distinta a la que tiene esos archivos.
# RENDER_DIR=../data/output
