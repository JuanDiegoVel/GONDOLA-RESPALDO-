# Configuracion del pipeline Gondola Inteligente.
# Copia este archivo a .env y ajusta lo que necesites:
#     cp .env.example .env
# El .env NUNCA se sube a git. Este .env.example SI, y no lleva secretos.
# Las rutas relativas se resuelven desde la raiz del repositorio.

# --- Entradas -------------------------------------------------------------
# Video de Scapder. Descargalo y dejalo en data/videos/ (no viene en git).
VIDEO_PATH=data/videos/video_001.mp4

# Etiqueta corta del video. Queda escrita en cada evento de salida.
VIDEO_ID=video_001

# Pesos del modelo YOLO. Se descargan aparte (no vienen en git).
MODEL_PATH=data/models/yolo11n.pt

# --- Salidas --------------------------------------------------------------
# Donde se escriben los .jsonl y los videos renderizados. Es regenerable.
OUTPUT_DIR=data/output

# Anotaciones manuales para medir exactitud. Esto SI se versiona.
GROUNDTRUTH_DIR=data/groundtruth

# --- Deteccion ------------------------------------------------------------
# Confianza minima para aceptar una deteccion. Entre 0.0 y 1.0.
# Subelo si aparecen personas donde no las hay; bajalo si se pierden personas.
CONFIDENCE_THRESHOLD=0.5

# Solapamiento maximo entre cajas antes de descartar la duplicada. 0.0 a 1.0.
IOU_THRESHOLD=0.45

# Lado en pixeles al que se redimensiona el frame para el modelo. 320 a 1920.
# Mas grande = mas preciso y mas lento.
IMGSZ=640

# --- Recorrido del video --------------------------------------------------
# Procesa 1 de cada N frames. 1 = todos. Subelo para ir mas rapido en pruebas.
FRAME_STRIDE=1

# Corta despues de N frames. 0 = procesar el video completo.
# Ponlo en 100 mientras desarrollas: no esperes 10 minutos para ver un error.
MAX_FRAMES=0

# Donde corre el modelo: cpu, cuda (GPU NVIDIA) o mps (Mac con chip Apple).
DEVICE=cpu

# --- Salida visual y registro ---------------------------------------------
# privacy = POR DEFECTO. Fondo neutro, sin ninguna imagen real: solo los
#           rectangulos, el frame, el timestamp y el conteo. Se puede proyectar
#           en cualquier presentacion sin exponer a nadie.
# debug   = cajas verdes sobre el video original. Para trabajar, NO para mostrar.
# none    = no genera video. Mas rapido.
RENDER_MODE=privacy

# Detalle de los mensajes: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
